{
  "note": "Data, never logic. The deterministic fallback plan for each event type (Muse drafts first; this is used when Muse is unavailable or its draft fails validation). `owner` is a hint the server resolves to a real family member: honoree, elder, host, adult, child, everyone. Songs are real, named recordings only (title + artist); the app links to YouTube Music / Spotify search, never hosted audio. `byOccasion` maps an occasion slug (rituals/*.json or data/traditions.json key) to a type, and may override the moment step. Plans focus on wishes, songs, real photos and voices. Nothing to buy, order or bring is ever in the default plan: `extras` (a cake, flowers, sweets) is added only when an owner or admin asks for it.",
  "types": {
    "birthday": {
      "label": "Birthday",
      "titleFor": "{name}'s birthday celebration",
      "sittingReason": "birthday",
      "minutes": 45,
      "runOfShow": [
        {
          "title": "Welcome",
          "minutes": 5,
          "owner": "host",
          "note": "Say hello across homes. Everyone unmutes once."
        },
        {
          "title": "The Chorus of wishes",
          "minutes": 10,
          "owner": "everyone",
          "note": "One wish each, youngest first."
        },
        {
          "title": "A story from an elder",
          "minutes": 10,
          "owner": "elder",
          "note": "The day they were born, or a year that mattered."
        },
        {
          "title": "Sing together",
          "minutes": 5,
          "owner": "everyone",
          "note": "Their song plays; everyone sings from their own home."
        },
        {
          "title": "Open chat",
          "minutes": 15,
          "owner": "everyone",
          "note": "No agenda."
        }
      ],
      "tasks": [
        {
          "text": "Record your wish, voice or video",
          "owner": "everyone"
        },
        {
          "text": "Collect old photos for the call",
          "owner": "adult"
        },
        {
          "text": "Pick the song and a GIF for the moment",
          "owner": "child"
        },
        {
          "text": "Send the link to everyone",
          "owner": "host"
        }
      ],
      "extras": {
        "step": {
          "title": "Cake and candles",
          "minutes": 5,
          "owner": "honoree",
          "note": "Sing together, then blow the candles out."
        },
        "tasks": [
