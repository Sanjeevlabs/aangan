# Copy to .env.local for local dev. Never commit .env.local.
# The key is read from the environment only; it is never written to any file.
META_API_KEY=
# Optional: Baseten-hosted Muse Spark Open (meta-models/muse-spark-open-1026).
# With a key, failed Muse calls retry there; MUSE_PROVIDER=baseten makes it primary.
BASETEN_API_KEY=
# Optional: our own Muse Spark Open endpoint on Modal (modal/muse_server.py, vLLM,
# OpenAI-compatible). Needs both values; joins the failover chain meta -> baseten -> modal.
MODAL_MUSE_URL=
MODAL_API_KEY=
MODAL_MUSE_MODEL=
# meta (default) | baseten | modal
MUSE_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sign-in (Supabase Auth). Email (magic link + code) is always on when Supabase is set.
# Google: enable the Google provider in Supabase -> Authentication -> Providers, and add
#   <APP_ORIGIN>/auth/callback to Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_AUTH_GOOGLE=true
# Phone: needs an SMS provider (Twilio, MessageBird, Vonage) configured in Supabase.
NEXT_PUBLIC_AUTH_PHONE=false
# Set to "true" with MOCK=true so the browser uses the demo code (000000) instead of Supabase.
NEXT_PUBLIC_MOCK=
# Server-only Supabase service-role key. NEVER prefix with NEXT_PUBLIC_.
# Used only by Next.js server routes (signed upload/download URLs, DB writes).
# The anon key is not used for data access in V1.
SUPABASE_SECRET_KEY=
MOCK=true
# V1 access control: invite codes are exchanged for an httpOnly signed
# session cookie. Set both to long random strings in every environment.
SESSION_SECRET=
CRON_SECRET=
# Optional: Google Maps browser key for "Around home" (Street View + Photorealistic 3D).
# A browser key is public by design: restrict it to your domain (HTTP referrers) and to
# Maps JavaScript API + Map Tiles API in Google Cloud. Without it, an illustrated map is shown.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
