# Copy to .env.local for local dev. Never commit .env.local.
# The key is read from the environment only; it is never written to any file.
META_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service-role key. NEVER prefix with NEXT_PUBLIC_.
# Used only by Next.js server routes (signed upload/download URLs, DB writes).
# The anon key is not used for data access in V1.
SUPABASE_SECRET_KEY=
MOCK=true
# V1 access control: invite codes are exchanged for an httpOnly signed
# session cookie. Set both to long random strings in every environment.
SESSION_SECRET=
CRON_SECRET=
# Optional: Google Maps browser key for "Around home" (Street View + Photorealistic 3D).
# A browser key is public by design: restrict it to your domain (HTTP referrers) and to
# Maps JavaScript API + Map Tiles API in Google Cloud. Without it, an illustrated map is shown.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
